<div class="max-w-3xl mx-auto py-8">

    <h1 class="text-2xl font-bold mb-6">Edit Blog</h1>

    <form action="/admin/edit/{{blog._id}}" method="POST" class="bg-white p-6 rounded shadow">

        <label class="block font-semibold mb-2">Title</label>
        <input name="title"
               value="{{blog.title}}"
               class="w-full border p-3 rounded mb-4">

        <label class="block font-semibold mb-2">Content</label>
        <textarea name="content"
                  rows="10"
                  class="w-full border p-3 rounded mb-4">{{blog.content}}</textarea>

        <button class="bg-indigo-600 text-white px-4 py-2 rounded">
            Update Blog
        </button>

    </form>

</div>