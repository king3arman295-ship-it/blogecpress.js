<div class="max-w-3xl mx-auto py-8">

    <h1 class="text-2xl font-bold mb-4">Edit Blog</h1>

    <form action="/admin/edit/{{blog._id}}" method="POST">

        <input name="title"
               value="{{blog.title}}"
               class="w-full border p-3 mb-3 rounded"
               placeholder="Title">

        <textarea name="content"
                  class="w-full border p-3 mb-3 rounded"
                  rows="10">{{blog.content}}</textarea>

        <button class="bg-indigo-600 text-white px-4 py-2 rounded">
            Update
        </button>

    </form>

</div>