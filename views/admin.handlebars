<h1>Add New Blog</h1>

<form action="/admin/add-blog" method="POST">

    <div class="mb-3">
        <label class="form-label">Title</label>

        <input
            type="text"
            name="title"
            class="form-control"
            required>
    </div>

    <div class="mb-3">
        <label class="form-label">Slug</label>

        <input
            type="text"
            name="slug"
            class="form-control"
            required>
    </div>

    <div class="mb-3">
        <label class="form-label">Content</label>

        <textarea
            name="content"
            rows="10"
            class="form-control"
            required></textarea>
    </div>

    <button
        type="submit"
        class="btn btn-success">

        Publish Blog

    </button>
    

</form>
<hr class="my-5">

<h2>Manage Blogs</h2>

{{#each blogs}}

<div class="card mb-3 p-3">

    <h4>{{this.title}}</h4>

    <p>{{this.slug}}</p>

    <div class="d-flex gap-2">

        <a
            href="/admin/edit/{{this._id}}"
            class="btn btn-primary">

            Edit

        </a>

        <form
            action="/admin/delete/{{this._id}}"
            method="POST">

            <button
                class="btn btn-danger">

                Delete

            </button>

        </form>

    </div>

</div>

{{/each}}