<script>
       

    async function toggleLike(slug) {

        try {

            const response = await fetch(
                `/blogpost/${slug}/like`,
                {
                    method: 'POST'
                }
            );

            const data = await response.json();

            if (data.success) {

                document.getElementById(
                    `likes-${slug}`
                ).innerText = data.likes;

                document.getElementById(
                    `heart-${slug}`
                ).innerText =
                    data.liked ? "❤️" : "🤍";

            }

        } catch (err) {

            console.log(err);

        }

    }

</script>

<div class="max-w-3xl mx-auto py-6">

    {{#each blogs}}

    <div class="bg-white rounded-3xl shadow-lg mb-6 overflow-hidden border border-gray-100">

        <!-- Header -->
        <div class="flex items-center p-4">

            <div class="w-12 h-12 rounded-full bg-gradient-to-r from-purple-500 to-pink-500"></div>

            <div class="ml-3">
                <h6 class="font-bold text-gray-800 mb-0">
                    Admin
                </h6>

                <small class="text-gray-500">
                    Published Blog
                </small>
            </div>

        </div>

        <!-- Fake Post Image -->
        <div class="h-56 bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500"></div>

        <!-- Content -->
        <div class="p-4">

            <h3 class="font-bold text-2xl text-gray-800 mb-3">
                {{this.title}}
            </h3>

            <p class="text-gray-600">
                {{this.content}}
            </p>

            <!-- Actions -->
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-4">

                <div class="flex gap-3">

                    <!-- Like Button -->
                    <button type="button" onclick="toggleLike('{{this.slug}}')"
                        class="px-4 py-2 rounded-full bg-red-50 hover:bg-red-100 text-red-500 font-medium">

                        <span id="heart-{{this.slug}}">
                            {{#if this.isLiked}}
                            ❤️
                            {{else}}
                            🤍
                            {{/if}}
                        </span>

                        <span id="likes-{{this.slug}}">
                            {{#if this.likes}}
                            {{this.likes}}
                            {{else}}
                            0
                            {{/if}}
                        </span>

                    </button>

                    <!-- Comment Button -->
                    <a href="/blogpost/{{this.slug}}"
                        class="px-4 py-2 rounded-full bg-blue-50 hover:bg-blue-100 text-blue-500 font-medium">

                        💬

                        {{#if this.comments.length}}
                        {{this.comments.length}}
                        {{else}}
                        0
                        {{/if}}

                    </a>

                </div>

                <!-- Read More -->
                <a href="/blogpost/{{this.slug}}"
                    class="w-full sm:w-auto bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-full font-medium transition text-sm sm:text-base text-center">

                    Read More →

                </a>

            </div>

        </div>

    </div>

    {{/each}}
    {{!-- ===================== --}}
    {{!-- PAGINATION UI --}}
    {{!-- ===================== --}}

    <div class="flex justify-center mt-8 gap-2 flex-wrap">

        {{!-- PREVIOUS BUTTON --}}
        {{#if (gt currentPage 1)}}
        <a href="/blog?page={{subtract currentPage 1}}" class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300">
            ← Prev
        </a>
        {{/if}}

        {{!-- PAGE NUMBERS --}}
        {{#each (array totalPages)}}
        <a href="/blog?page={{this}}" class="px-4 py-2 rounded-lg 
           {{#if (eq ../currentPage this)}}
               bg-indigo-600 text-white
           {{else}}
               bg-gray-200 hover:bg-gray-300
           {{/if}}">
            {{this}}
        </a>
        {{/each}}

        {{!-- NEXT BUTTON --}}
        {{#if (lt currentPage totalPages)}}
        <a href="/blog?page={{add currentPage 1}}" class="px-4 py-2 bg-gray-200 rounded-lg hover:bg-gray-300">
            Next →
        </a>
        {{/if}}

    </div>

</div>