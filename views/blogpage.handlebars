<style>
    /* MOBILE RESPONSIVE FIXES */

    @media (max-width: 768px) {

        .max-w-4xl {
            padding-left: 12px;
            padding-right: 12px;
        }

        .p-8 {
            padding: 1rem !important;
        }

        h1.text-4xl {
            font-size: 2rem !important;
            line-height: 1.3;
        }

        h3.text-3xl {
            font-size: 1.6rem !important;
        }

        .text-lg {
            font-size: 1rem !important;
        }

        .leading-8 {
            line-height: 1.7 !important;
        }

        .ml-12 {
            margin-left: 0 !important;
        }

        .reply-box {
            width: 100%;
        }

        .reply-form-row {
            flex-direction: column;
        }

        .reply-form-row button {
            width: 100%;
            margin-top: 8px;
        }

        textarea,
        input {
            font-size: 16px;
        }

        .emoji-btn,
        .reply-emoji {
            width: auto !important;
        }

        .w-12.h-12 {
            width: 42px !important;
            height: 42px !important;
        }

        .w-10.h-10 {
            width: 36px !important;
            height: 36px !important;
        }
    }

    @media (max-width: 480px) {

        h1.text-4xl {
            font-size: 1.6rem !important;
        }

        h3.text-3xl {
            font-size: 1.4rem !important;
        }

        .emoji-btn,
        .reply-emoji {
            padding: 4px 8px !important;
            font-size: 14px;
        }
    }
</style>
<div class="max-w-4xl mx-auto px-2 md:px-0">

    <!-- Blog Card -->
    <div class="bg-white rounded-3xl shadow-lg overflow-hidden">

        <!-- Header -->
        <div class="p-8 border-b">

            <div class="flex items-center gap-3 mb-4">

                <div class="w-12 h-12 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold">
                    A
                </div>

                <div>
                    <h6 class="font-semibold mb-0">Admin</h6>
                    <small class="text-gray-500">Blog Post</small>
                </div>

            </div>

            <h1 class="text-4xl font-bold text-gray-800">
                {{title}}
            </h1>

        </div>

        <!-- Content -->
        <div class="p-8">

            <div class="text-lg leading-8 text-gray-700 whitespace-pre-line">
                {{content}}
            </div>

        </div>

    </div>


    <!-- Comment Form -->
    <div class="bg-white rounded-3xl shadow-lg mt-8 p-8">

        <h3 class="text-2xl font-bold mb-4">Leave a Comment</h3>

        {{#if user}}

        <!-- Emoji Buttons -->
        <div class="flex gap-2 mb-3 flex-wrap">

            <button type="button" class="emoji-btn bg-gray-100 px-3 py-1 rounded">😀</button>
            <button type="button" class="emoji-btn bg-gray-100 px-3 py-1 rounded">😂</button>
            <button type="button" class="emoji-btn bg-gray-100 px-3 py-1 rounded">😍</button>
            <button type="button" class="emoji-btn bg-gray-100 px-3 py-1 rounded">🔥</button>
            <button type="button" class="emoji-btn bg-gray-100 px-3 py-1 rounded">❤️</button>
            <button type="button" class="emoji-btn bg-gray-100 px-3 py-1 rounded">👍</button>

        </div>

       <form id="commentForm">
            <textarea id="commentBox" name="comment" rows="4"
                class="w-full border border-gray-300 rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-indigo-500"
                placeholder="Write your thoughts... 😊" required></textarea>

            <button type="submit" class="mt-4 bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl">

                Post Comment

            </button>

        </form>

        {{else}}

        <div class="bg-red-50 border border-red-200 text-red-600 p-4 rounded-xl">
            Please login to comment.
        </div>

        {{/if}}

    </div>


    <!-- Comments -->
    <div class="mt-8" id="commentsContainer">

        <h3 class="text-3xl font-bold mb-6">Comments</h3>

        {{#if comments.length}}

        {{#each comments}}

        <div class="bg-white rounded-2xl shadow-md p-6 mb-6">

            <!-- Comment -->
            <div class="flex items-start gap-3">

                <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center">
                    👤
                </div>

                <div class="flex-1">

                    <h6 class="font-semibold text-gray-800">
                        {{this.userEmail}}
                    </h6>

                    <p class="mt-2 text-gray-700">
                        {{this.text}}
                    </p>

                </div>

            </div>

            <!-- Reply Form -->
            {{#if ../user}}

            <form
    class="mt-4 ml-12 replyForm"
    data-slug="{{../slug}}"
    data-comment-id="{{this._id}}">

                <!-- Emoji Row -->
                <div class="flex gap-2 mb-2 flex-wrap">

                    <button type="button" class="reply-emoji bg-gray-100 px-2 py-1 rounded">😀</button>
                    <button type="button" class="reply-emoji bg-gray-100 px-2 py-1 rounded">😂</button>
                    <button type="button" class="reply-emoji bg-gray-100 px-2 py-1 rounded">😍</button>
                    <button type="button" class="reply-emoji bg-gray-100 px-2 py-1 rounded">🔥</button>
                    <button type="button" class="reply-emoji bg-gray-100 px-2 py-1 rounded">❤️</button>
                    <button type="button" class="reply-emoji bg-gray-100 px-2 py-1 rounded">👍</button>

                </div>

                <div class="flex gap-2 reply-form-row">

                    <input type="text" name="reply" class="flex-1 border rounded-xl px-4 py-2 reply-box"
                        placeholder="Reply to comment... 😊">

                    <button class="bg-slate-700 text-white px-4 py-2 rounded-xl">
                        Reply
                    </button>

                </div>

            </form>

            {{/if}}

            <!-- Replies -->
            {{#if this.replies.length}}

            <div class="ml-12 mt-6 space-y-3">

                {{#each this.replies}}

                <div class="bg-slate-50 border-l-4 border-indigo-500 p-4 rounded-r-xl">

                    <strong class="text-indigo-600">
                        {{this.userEmail}}
                    </strong>

                    <p class="mt-1 text-gray-700">
                        {{this.text}}
                    </p>

                </div>

                {{/each}}

            </div>

            {{/if}}

        </div>

        {{/each}}

        {{else}}

        <div class="bg-white rounded-2xl shadow p-6 text-center text-gray-500">
            No comments yet. Be the first to comment!
        </div>

        {{/if}}

    </div>

</div>

<!-- SCRIPT -->
<script>

// =====================
// COMMENT EMOJIS
// =====================

const commentBox = document.getElementById("commentBox");

document.querySelectorAll(".emoji-btn").forEach(btn => {

    btn.addEventListener("click", () => {

        commentBox.value += btn.innerText;
        commentBox.focus();

    });

});


// =====================
// REPLY EMOJIS
// =====================

document.querySelectorAll(".reply-emoji").forEach(btn => {

    btn.addEventListener("click", () => {

        const input =
            btn.closest("form")
               .querySelector(".reply-box");

        input.value += btn.innerText;

        input.focus();

    });

});


// =====================
// AJAX COMMENT
// =====================

const commentForm =
    document.getElementById("commentForm");

if(commentForm){

commentForm.addEventListener(
    "submit",
    async function(e){

        e.preventDefault();

        const comment =
            commentBox.value;

        const response =
            await fetch(
                "/blogpost/{{slug}}/comment",
                {
                    method:"POST",
                    headers:{
                        "Content-Type":
                        "application/json"
                    },
                    body:JSON.stringify({
                        comment
                    })
                }
            );

        const data =
            await response.json();

        if(data.success){

            const html = `
            <div class="bg-white rounded-2xl shadow-md p-6 mb-6">

                <div class="flex items-start gap-3">

                    <div class="w-10 h-10 rounded-full bg-slate-200 flex items-center justify-center">
                        👤
                    </div>

                    <div class="flex-1">

                        <h6 class="font-semibold text-gray-800">
                            ${data.userEmail}
                        </h6>

                        <p class="mt-2 text-gray-700">
                            ${data.text}
                        </p>

                    </div>

                </div>

            </div>
            `;

            document
                .getElementById(
                    "commentsContainer"
                )
                .insertAdjacentHTML(
                    "beforeend",
                    html
                );

            commentBox.value = "";

        }

    }
);

}


// =====================
// AJAX REPLIES
// =====================

document.querySelectorAll(".replyForm").forEach(form => {

    form.addEventListener(
        "submit",
        async function(e){

            e.preventDefault();

            const slug =
                form.dataset.slug;

            const commentId =
                form.dataset.commentId;

            const replyInput =
                form.querySelector(".reply-box");

            const reply =
                replyInput.value;

            if(!reply.trim()) return;

            const response =
                await fetch(
                    `/blogpost/${slug}/reply/${commentId}`,
                    {
                        method:"POST",
                        headers:{
                            "Content-Type":
                            "application/json"
                        },
                        body:JSON.stringify({
                            reply
                        })
                    }
                );

            const data =
                await response.json();

            if(data.success){

                const repliesContainer =
                    form.parentElement.querySelector(".space-y-3");

                const replyHtml = `
                <div class="bg-slate-50 border-l-4 border-indigo-500 p-4 rounded-r-xl">

                    <strong class="text-indigo-600">
                        ${data.userEmail}
                    </strong>

                    <p class="mt-1 text-gray-700">
                        ${data.text}
                    </p>

                </div>
                `;

                if(repliesContainer){

                    repliesContainer.insertAdjacentHTML(
                        "beforeend",
                        replyHtml
                    );

                } else {

                    const wrapper =
                    document.createElement("div");

                    wrapper.className =
                    "ml-12 mt-6 space-y-3";

                    wrapper.innerHTML =
                    replyHtml;

                    form.insertAdjacentElement(
                        "afterend",
                        wrapper
                    );

                }

                replyInput.value = "";

            }

        }
    );

});

</script>