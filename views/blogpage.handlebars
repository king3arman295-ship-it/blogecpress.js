<div class="post-card">

    <h2>{{title}}</h2>
    <p>{{content}}</p>

    <hr>

    <!-- COMMENT FORM -->
    <h5>Add Comment</h5>

    {{#if user}}

        <form action="/blogpost/{{slug}}/comment" method="POST">

            <div class="mb-3">
                <textarea
                    name="comment"
                    class="form-control"
                    placeholder="Write your comment..."
                    required></textarea>
            </div>

            <button class="btn btn-primary btn-sm">
                Post Comment
            </button>

        </form>

    {{else}}

        <p class="text-danger">
            Please login to comment
        </p>

    {{/if}}

    <hr>

    <!-- COMMENTS LIST -->
    <h5>Comments</h5>

    {{#if comments.length}}

   {{#each comments}}

<div class="border rounded p-3 mb-3">

    <strong>{{this.userEmail}}</strong>

    <p>{{this.text}}</p>

    <!-- Reply Form -->

    {{#if ../user}}

    <form
        action="/blogpost/{{../slug}}/reply/{{this._id}}"
        method="POST">

        <input
            type="text"
            name="reply"
            class="form-control mb-2"
            placeholder="Reply...">

        <button
            class="btn btn-sm btn-secondary">

            Reply

        </button>

    </form>

    {{/if}}

    <!-- Replies -->

    <div class="ms-4 mt-3">

        {{#each this.replies}}

            <div class="border-start ps-3 mb-2">

                <strong>
                    {{this.userEmail}}
                </strong>

                <p class="mb-0">
                    {{this.text}}
                </p>

            </div>

        {{/each}}

    </div>

</div>

{{/each}}

    {{else}}

        <p class="text-muted">No comments yet</p>

    {{/if}}

</div>